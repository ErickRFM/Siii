# Copiar a .env.local SOLO para uso local. Supabase -> Connect -> PostgreSQL URI.
# NO es https://<project>.supabase.co; no subir secretos al repositorio.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
LOG_LEVEL=info
# Bootstrap inicial SOLO con base de identidad vacía. Usar secret manager, no conservar valores aquí.
# SIII_BOOTSTRAP_CONFIRM=YES
# SIII_BOOTSTRAP_USERNAME=
# SIII_BOOTSTRAP_PASSWORD=
# SIII_BOOTSTRAP_INSTITUTION_CODE=
# SIII_BOOTSTRAP_INSTITUTION_NAME=

# P0: runtime debe usar LOGIN que herede solo siii_app; nunca propietario/migrador.
SIII_POOL_MAX=5
# CLI migrate/baseline requiere entorno explícito no productivo.
# SIII_DATABASE_ENV=development
# Integración/UI: solo PostgreSQL local desechable con SIII_DATABASE_ENV=test.
# INTEGRATION_DATABASE_URL se obtiene del gestor local de secretos.
