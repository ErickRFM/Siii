# Copiar a .env.local SOLO para uso local. Supabase -> Connect -> PostgreSQL URI.
# NO es https://<project>.supabase.co; no subir secretos al repositorio.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME?sslmode=require
LOG_LEVEL=info
# Bootstrap inicial SOLO con base de identidad vacía. Usar secret manager, no conservar valores aquí.
# SIII_BOOTSTRAP_CONFIRM=YES
# SIII_BOOTSTRAP_USERNAME=
# SIII_BOOTSTRAP_PASSWORD=
# SIII_BOOTSTRAP_INSTITUTION_CODE=
# SIII_BOOTSTRAP_INSTITUTION_NAME=

# P0: runtime debe usar LOGIN que herede solo siii_app; nunca propietario/migrador.
SIII_POOL_MAX=5
# CLI migrate/baseline requiere entorno explícito no productivo.
# SIII_DATABASE_ENV=development
# Integración/UI: solo PostgreSQL local desechable con SIII_DATABASE_ENV=test.
# INTEGRATION_DATABASE_URL se obtiene del gestor local de secretos.

# P1 MFA: claves SOLO servidor; JSON {"key-id":"BASE64_DE_32_BYTES_ALEATORIOS"}.
# Generar claves reales fuera de Git y conservar las anteriores para descifrar factores vigentes.
# SIII_MFA_KEYS=
# SIII_MFA_ACTIVE_KEY_ID=

# F08: origen público HTTPS, sin path, query ni credenciales.
# SIII_PUBLIC_ORIGIN=https://sis.example.edu
# Keyring de invitaciones separado de MFA; entre 1 y 16 claves Base64 canónicas de 32 bytes.
# Mantener claves antiguas mientras haya eventos cifrados pendientes. No usar valores de ejemplo como claves.
# SIII_INVITATION_KEYS=
# SIII_INVITATION_ACTIVE_KEY_ID=
# Correo transaccional SOLO servidor; configurar remitente autorizado y Reply-To explícitos.
# La credencial OAuth del conector no es una RESEND_API_KEY del runtime.
# Sin esta configuración, el outbox queda pendiente con EMAIL_NOT_CONFIGURED.
# RESEND_API_KEY=
# SIII_EMAIL_FROM=
# SIII_EMAIL_REPLY_TO=
# Worker por lote (scheduler externo): npx tsx worker/invitations.ts
# DATABASE_URL de worker/web usa LOGIN restringido a siii_app; nunca propietario ni migrador.

# F06: keyring de recuperación independiente de MFA e invitaciones; SOLO servidor.
# JSON de claves aleatorias Base64 canónicas de 32 bytes; conservar anteriores mientras haya eventos pendientes.
# SIII_PASSWORD_RESET_KEYS=
# SIII_PASSWORD_RESET_ACTIVE_KEY_ID=
# Recuperación reutiliza SIII_PUBLIC_ORIGIN HTTPS y configuración explícita de correo.
# Worker por lote (scheduler externo): npx tsx worker/password-resets.ts
